# Public API URL — used by client-side fetches and server components.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Internal API URL — used by Next.js server (RSC, route handlers).
# Often same as NEXT_PUBLIC_API_URL in dev; in production may point to an
# internal load balancer (e.g. http://api.internal/api/v1).
INTERNAL_API_URL=http://localhost:8000/api/v1
