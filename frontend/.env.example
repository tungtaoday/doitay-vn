# Public API URL — used by client-side fetches and server components.
# Dev:  http://localhost:8080/api/v1
# Prod: https://doitay.vn/api/v1  (hoặc http://165.22.252.188/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Internal API URL — used by Next.js server (RSC, route handlers, server actions).
# Dev = same as above. Prod = URL public của API vì Vercel không access internal network.
INTERNAL_API_URL=http://localhost:8080/api/v1

# Social login (optional — leave blank to hide buttons)
# Get from https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Get from https://developers.facebook.com/apps
NEXT_PUBLIC_FACEBOOK_APP_ID=
