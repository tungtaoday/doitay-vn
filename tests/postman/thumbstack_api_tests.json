{
  "info": {
    "name": "Thumbstack API Tests",
    "description": "Comprehensive API testing for Thumbstack platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "contractorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "leadId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has token\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.collectionVariables.set('customerToken', jsonData.token);",
                  "});",
                  "",
                  "pm.test(\"User role is customer\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.user.role).to.eql('customer');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Contractor Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Contractor login successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has token\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.collectionVariables.set('contractorToken', jsonData.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"contractor@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Lead Management",
      "item": [
        {
          "name": "TC-001: Create Lead - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Lead created successfully\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains lead data\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('lead_id');",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "    pm.expect(jsonData.status).to.eql('active');",
                  "    pm.collectionVariables.set('leadId', jsonData.lead_id);",
                  "});",
                  "",
                  "pm.test(\"Lead has correct data\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.title).to.eql('Test API Lead Creation');",
                  "    pm.expect(jsonData.district).to.eql('Quận 1');",
                  "    pm.expect(jsonData.urgency).to.eql('medium');",
                  "});",
                  "",
                  "pm.test(\"Response time is acceptable\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1,\n  \"title\": \"Test API Lead Creation\",\n  \"description\": \"This is a test lead created via API for testing purposes\",\n  \"district\": \"Quận 1\",\n  \"ward\": \"Phường Bến Nghé\",\n  \"address\": \"123 API Test Street\",\n  \"budget_min\": 200000,\n  \"budget_max\": 500000,\n  \"urgency\": \"medium\",\n  \"needed_by\": \"2024-12-31\",\n  \"requirements\": [\"API Testing\", \"Automation\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customer/leads",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "leads"]
            }
          }
        },
        {
          "name": "TC-002: Create Lead - Validation Error",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Validation error returned\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test(\"Error messages present\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('errors');",
                  "    pm.expect(jsonData.errors).to.have.property('title');",
                  "    pm.expect(jsonData.errors).to.have.property('description');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customer/leads",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "leads"]
            }
          }
        },
        {
          "name": "TC-003: Get Lead Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Lead details retrieved\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Lead data is complete\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('title');",
                  "    pm.expect(jsonData).to.have.property('description');",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "    pm.expect(jsonData).to.have.property('category');",
                  "    pm.expect(jsonData).to.have.property('customer');",
                  "});",
                  "",
                  "pm.test(\"Customer data is protected\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.customer_info) {",
                  "        pm.expect(jsonData.customer_info.phone).to.not.exist;",
                  "        pm.expect(jsonData.customer_info.email).to.not.exist;",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/leads/{{leadId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "leads", "{{leadId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Contractor Lead Purchase",
      "item": [
        {
          "name": "TC-006: Purchase Lead - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Lead purchased successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Purchase confirmation received\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('purchase_id');",
                  "    pm.expect(jsonData).to.have.property('customer_info');",
                  "    pm.expect(jsonData.status).to.eql('purchased');",
                  "});",
                  "",
                  "pm.test(\"Customer info is unlocked\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.customer_info).to.have.property('phone');",
                  "    pm.expect(jsonData.customer_info).to.have.property('email');",
                  "    pm.expect(jsonData.customer_info).to.have.property('name');",
                  "});",
                  "",
                  "pm.test(\"Wallet balance updated\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('new_wallet_balance');",
                  "    pm.expect(jsonData.transaction_amount).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{contractorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contractor/leads/{{leadId}}/purchase",
              "host": ["{{baseUrl}}"],
              "path": ["contractor", "leads", "{{leadId}}", "purchase"]
            }
          }
        },
        {
          "name": "TC-007: Purchase Lead - Insufficient Balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Purchase blocked due to insufficient funds\", function () {",
                  "    pm.response.to.have.status(402);",
                  "});",
                  "",
                  "pm.test(\"Appropriate error message\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('insufficient');",
                  "    pm.expect(jsonData).to.have.property('required_amount');",
                  "    pm.expect(jsonData).to.have.property('current_balance');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{contractorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/contractor/leads/{{leadId}}/purchase",
              "host": ["{{baseUrl}}"],
              "path": ["contractor", "leads", "{{leadId}}", "purchase"]
            }
          }
        }
      ]
    },
    {
      "name": "Notification System",
      "item": [
        {
          "name": "TC-015: Get Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Notifications retrieved\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Notification structure is correct\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('count');",
                  "    pm.expect(jsonData).to.have.property('notifications');",
                  "    pm.expect(jsonData.notifications).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Notification items have required fields\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.notifications.length > 0) {",
                  "        const notification = jsonData.notifications[0];",
                  "        pm.expect(notification).to.have.property('id');",
                  "        pm.expect(notification).to.have.property('title');",
                  "        pm.expect(notification).to.have.property('message');",
                  "        pm.expect(notification).to.have.property('time');",
                  "        pm.expect(notification).to.have.property('type');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{contractorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/unread-count",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "unread-count"]
            }
          }
        },
        {
          "name": "TC-015: Mark Notifications as Read",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Notifications marked as read\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Success confirmation\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{contractorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/mark-all-read",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "mark-all-read"]
            }
          }
        }
      ]
    },
    {
      "name": "Performance Tests",
      "item": [
        {
          "name": "Load Test - Multiple Lead Creation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// This test should be run with multiple iterations",
                  "const leadTitle = `Load Test Lead ${Date.now()}`;",
                  "pm.globals.set('leadTitle', leadTitle);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response time under 3 seconds\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  "",
                  "pm.test(\"Lead created successfully under load\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Database handles concurrent requests\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('lead_id');",
                  "    pm.expect(jsonData.lead_id).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1,\n  \"title\": \"{{leadTitle}}\",\n  \"description\": \"Load testing lead creation with multiple concurrent requests\",\n  \"district\": \"Quận 1\",\n  \"ward\": \"Phường Bến Nghé\",\n  \"address\": \"Load Test Address\",\n  \"budget_min\": 100000,\n  \"budget_max\": 300000,\n  \"urgency\": \"medium\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customer/leads",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "leads"]
            }
          }
        }
      ]
    },
    {
      "name": "Security Tests",
      "item": [
        {
          "name": "TC-020: Unauthorized Access",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Unauthorized access blocked\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Error message appropriate\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('Unauthorized');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customer/leads",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "leads"]
            }
          }
        },
        {
          "name": "TC-020: Invalid Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Invalid token rejected\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Token validation works\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('Invalid') || pm.expect(jsonData.message).to.include('token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid_token_here"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/leads",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "leads"]
            }
          }
        },
        {
          "name": "TC-020: SQL Injection Protection",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"SQL injection blocked\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test(\"No database error exposed\", function () {",
                  "    const responseText = pm.response.text();",
                  "    pm.expect(responseText.toLowerCase()).to.not.include('sql');",
                  "    pm.expect(responseText.toLowerCase()).to.not.include('select');",
                  "    pm.expect(responseText.toLowerCase()).to.not.include('database');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"'; DROP TABLE leads; --\",\n  \"title\": \"SQL Injection Test\",\n  \"description\": \"Testing SQL injection protection\",\n  \"district\": \"Quận 1\",\n  \"ward\": \"Phường Test\",\n  \"address\": \"123 Test\",\n  \"urgency\": \"medium\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customer/leads",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "leads"]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global pre-request script",
          "console.log('Running API test:', pm.info.requestName);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test script",
          "pm.test('Response headers include security headers', function () {",
          "    pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.exist;",
          "    pm.expect(pm.response.headers.get('X-Frame-Options')).to.exist;",
          "});",
          "",
          "pm.test('Response is JSON', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('json');",
          "});"
        ]
      }
    }
  ]
} 